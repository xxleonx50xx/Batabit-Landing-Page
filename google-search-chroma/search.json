{
  "size": [1080, 1920],
  "fps": 60,
  "background": "#0000FF",
  "text": "¿Donde está GreenMex?",
  "font": "fonts/Roboto-Regular.ttf",
  "font_medium": "fonts/Roboto-Medium.ttf",

  "bar": {
    "width": 880,
    "height": 124,
    "radius": 62,
    "center_y_ratio": 0.5,
    "color": "#FFFFFF",
    "shadow": { "opacity": 0.22, "blur": 22, "offset": [0, 6] }
  },

  "icons": {
    "size": 44,
    "padding": 40,
    "stroke": 4.2,
    "search_color": "#9AA0A6",
    "search_active_color": "#4285F4",
    "mic_style": "google",
    "mic_colors": { "capsule": "#4285F4", "stem": "#34A853", "left": "#FBBC05", "right": "#EA4335" },
    "mic_gray": "#9AA0A6"
  },

  "typography": { "size": 44, "color": "#202124", "gap_after_icon": 26 },
  "caret": { "width": 3, "height": 52, "blink": 1.06 },

  "dropdown": {
    "enabled": true,
    "after_chars": 6,
    "suggestions": ["GreenMex ubicación", "GreenMex horario", "GreenMex sucursales"],
    "row_height": 72,
    "font_size": 36,
    "padding_top": 30,
    "padding_bottom": 16,
    "radius": 30,
    "open": 0.32,
    "stagger": 0.05,
    "close": 0.22,
    "hover_before_enter": 0.22,
    "hover_color": "#F1F3F4",
    "icon_color": "#9AA0A6",
    "text_color": "#202124",
    "accent_color": "#4285F4"
  },

  "timing": {
    "appear": 0.6,
    "appear_scale_from": 0.55,
    "appear_overshoot": 1.7,
    "appear_rise": 70,
    "icons_pop_delay": [0.2, 0.32],
    "icons_pop": 0.34,
    "idle_float": 3,
    "idle_float_period": 2.4,
    "idle_before_typing": 0.4,
    "type_interval": 0.085,
    "type_jitter": 0.03,
    "type_space_pause": 0.07,
    "type_seed": 7,
    "char_pop": 0.11,
    "char_rise": 10,
    "pause_after_typing": 0.6,
    "caret_hide_before_enter": 0.12,
    "enter": 0.4,
    "enter_icon_scale": 1.4,
    "enter_press": 0.04,
    "enter_nudge": 12,
    "ripple": 0.5,
    "progress_delay": 0.12,
    "progress": 0.55,
    "hold_after_enter": 0.2,
    "exit": 0.42,
    "exit_style": "slide-fade",
    "exit_distance": 320,
    "exit_stretch": 0.14,
    "tail": 0.35
  },

  "motion_blur": { "samples": 8, "samples_small": 4, "shutter": 0.5 },
  "supersample": 2
}
